# tistory-comment-spam-cleaner 환경 설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. 최초 실행 시 자동으로 복사됩니다.
# 모든 키는 app/config/settings.py 의 Settings 필드와 1:1로 대응합니다.

# ---------------------------------------------------------------------------
# 웹 서버
# ---------------------------------------------------------------------------
# 로컬 전용 기본값. 외부에 노출하려면 0.0.0.0 으로 바꾸고 반드시 APP_AUTH_ENABLED=true 로 설정하세요.
APP_HOST=127.0.0.1
APP_PORT=8765
# 서버 기동 후 기본 브라우저를 자동으로 열지 여부
APP_OPEN_BROWSER=true

# ---------------------------------------------------------------------------
# 로깅
# ---------------------------------------------------------------------------
APP_LOG_LEVEL=INFO
APP_LOG_DIR=logs
# 일별 로그 파일 보관 일수
APP_LOG_RETENTION_DAYS=14
# 화면 표시와 로그 타임스탬프에 사용할 시간대
APP_TIMEZONE=Asia/Seoul

# ---------------------------------------------------------------------------
# 보안
# ---------------------------------------------------------------------------
# 쿠키 암호화와 세션 서명에 쓰는 키. 비워두면 최초 실행 시 자동 생성되어 .env 에 기록됩니다.
APP_SECRET_KEY=
# 외부 배포 시 true 로 바꾸면 로그인 화면이 활성화됩니다.
APP_AUTH_ENABLED=false
APP_AUTH_USERNAME=admin
# APP_AUTH_ENABLED=true 인데 비어 있으면 서버가 기동을 거부합니다.
APP_AUTH_PASSWORD=
# 로그인 세션 유지 시간(초)
APP_SESSION_MAX_AGE=43200

# ---------------------------------------------------------------------------
# 대상 블로그
# ---------------------------------------------------------------------------
APP_BLOG_URL=https://example.tistory.com
APP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# ---------------------------------------------------------------------------
# 데이터 경로 (상대 경로는 프로젝트 루트 기준)
# ---------------------------------------------------------------------------
APP_DATA_DIR=data
APP_DATABASE_URL=sqlite+aiosqlite:///data/comments.db
APP_BACKUP_DIR=data/backups
APP_CONFIG_DIR=config

# ---------------------------------------------------------------------------
# HTTP 클라이언트
# ---------------------------------------------------------------------------
APP_HTTP_TIMEOUT=20.0
APP_HTTP_MAX_RETRIES=5
APP_HTTP_BACKOFF_BASE=0.5
APP_HTTP_BACKOFF_MAX=30.0

# ---------------------------------------------------------------------------
# 댓글 수집
# ---------------------------------------------------------------------------
# 동시에 수집할 게시글 수
APP_COLLECT_CONCURRENCY=3
# 초당 요청 수 상한
APP_COLLECT_RPS=6.0

# ---------------------------------------------------------------------------
# 댓글 삭제
# ---------------------------------------------------------------------------
APP_DELETE_CONCURRENCY=3
APP_DELETE_RPS=4.0
# true 면 실제 삭제 요청을 보내지 않고 시뮬레이션만 합니다. 작업 생성 시 개별로 덮어쓸 수 있습니다.
APP_DELETE_DRY_RUN=true
# 연속 실패가 이 횟수에 도달하면 작업을 자동 일시정지합니다.
APP_CIRCUIT_BREAKER_THRESHOLD=10
# 삭제 전 백업 파일 생성 여부. false 로 두면 복구 수단이 사라집니다.
APP_BACKUP_BEFORE_DELETE=true

# ---------------------------------------------------------------------------
# 주기 모니터링
# ---------------------------------------------------------------------------
APP_MONITOR_ENABLED=false
APP_MONITOR_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# 화면
# ---------------------------------------------------------------------------
# 댓글 목록 한 페이지에 표시할 건수
APP_PAGE_SIZE=50
